# watchdog.env - copy to watchdog.env (no extension) and fill in real values.
# This file is read by watchdog.py to send Telegram alerts when checks fail.
# Both fields are required for Telegram alerts; if absent, watchdog runs but
# alerts are silent (still logged to watchdog.log).
#
# How to get these:
#   1. Create a Telegram bot via @BotFather, copy the token it gives you.
#   2. Send your bot any message, then visit
#      https://api.telegram.org/bot<TOKEN>/getUpdates
#      to find your chat_id in the response JSON.
#
# File permissions: chmod 600 watchdog.env  (do NOT commit the real version)

TELEGRAM_BOT_TOKEN=<paste-your-bot-token-here>
TELEGRAM_CHAT_ID=<paste-your-chat-id-here>
